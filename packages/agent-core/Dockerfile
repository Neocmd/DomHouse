FROM node:22-alpine AS builder
WORKDIR /app
# Copy root workspace manifest + lock (generated by `npm install` at repo root)
COPY package*.json ./
COPY packages/agent-core/package.json ./packages/agent-core/
RUN npm install --workspace=@domhouse/agent-core
COPY packages/agent-core/tsconfig.json ./packages/agent-core/
COPY packages/agent-core/src ./packages/agent-core/src
RUN cd packages/agent-core && npm run build

FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
COPY package*.json ./
COPY packages/agent-core/package.json ./packages/agent-core/
RUN npm install --workspace=@domhouse/agent-core --omit=dev
COPY --from=builder /app/packages/agent-core/dist ./packages/agent-core/dist
WORKDIR /app/packages/agent-core
EXPOSE 3000
CMD ["node", "dist/index.js"]
